# Optional per-team settings for the memory store.
# Parsed as plain KEY=VALUE, never executed as a shell script.

# Regex used to pull a ticket ID out of the branch name.
TASK_ID_PATTERN='[A-Z][A-Z0-9]+-[0-9]+'

# Base branches to diff against, in priority order, when origin/HEAD is unset.
BASE_BRANCHES='main master develop'

# Extra tokens to ignore when matching (your company name, product name, common
# package prefixes). Anything that appears in almost every path is noise.
EXTRA_STOP_WORDS=''
